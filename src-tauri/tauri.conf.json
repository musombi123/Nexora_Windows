{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora",
  "version": "0.1.0",
  "identifier": "com.nexora.foundry",
  "build": {
    "beforeBuildCommand": "npm --prefix workspace/foundry/apps/web run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../workspace/foundry/apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexora Foundry",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; connect-src ipc: http://127.0.0.1:8765 http://localhost:8765 https://nexora-foundry-api.onrender.com https://*.onrender.com; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; font-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Nexora Foundry",
    "longDescription": "Local-first game creation studio from NEXORA Interactive Studios.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
