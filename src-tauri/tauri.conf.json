{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXORA Studio Pro",
  "version": "0.1.1",
  "identifier": "com.nexora.foundry",
  "build": {
    "beforeDevCommand": "npm --prefix workspace/frontend/apps/nexora run dev -- --host 127.0.0.1 --port 5174 --base ./",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm --prefix workspace/frontend/apps/nexora run build -- --base ./",
    "frontendDist": "../workspace/frontend/public/dev_nexora"
  },
  "app": {
    "windows": [{
      "title": "NEXORA Studio Pro",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self' data: blob:; connect-src ipc: http://127.0.0.1:8765 http://localhost:8765 https://nexora-foundry-api.onrender.com https://*.onrender.com; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; font-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "NEXORA Studio Pro",
    "longDescription": "NEXORA desktop game development workspace.",
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller", "silent": true},
      "nsis": {"installMode": "currentUser", "displayLanguageSelector": false}
    }
  }
}
